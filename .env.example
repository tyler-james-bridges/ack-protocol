# ACK Protocol environment variables
# Copy to .env.local for local dev

# Required for SIWA nonce/signature verification
SIWA_NONCE_SECRET=replace-with-a-long-random-secret
RECEIPT_SECRET=replace-with-a-long-random-secret

# Required for 8004scan-backed API routes (mcp/discover/agents/reputation)
EIGHTOOSCAN_API_KEY=your-8004scan-api-key

# Public app config
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
# Default chain is Base (8453). Set abstract to keep Abstract, or testnet for Abstract testnet.
# NEXT_PUBLIC_CHAIN=base
NEXT_PUBLIC_WC_PROJECT_ID=your-walletconnect-project-id

# Public Base Builder Code (base.dev). Not a secret. Override to rotate attribution.
# BASE_BUILDER_CODE=bc_jhxtiha3
# NEXT_PUBLIC_BASE_BUILDER_CODE=bc_jhxtiha3

# Optional x402 metadata (experimental endpoint only)
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Default Base facilitator settles eip155:8453 but does not advertise builder-code.
# CDP (https://api.cdp.coinbase.com/platform/v2/x402) does, and requires API credentials
# this app does not send. Leave the openx402 URL unless that auth is wired.
BASE_X402_FACILITATOR_URL=https://facilitator.openx402.ai
# Set to 1 only when the facilitator above both settles Base and honors builder-code.
# BASE_X402_BUILDER_CODE=0

# Nevermined PAY integration (optional)
NVM_API_KEY=
NVM_ENVIRONMENT=sandbox
NVM_AGENT_ID=
NVM_PREPAID_PLAN_ID=
NVM_PAYG_PLAN_ID=

# Optional agent automation credentials (scripts)
AGENT_PRIVATE_KEY=

# ERC-8257 tool registration on Base (never commit a real key).
# PRIVATE_KEY is required only for live onchain registration.
# AGENT_PRIVATE_KEY is also accepted by scripts/register-tool.ts.
# PRIVATE_KEY=
# Optional overrides for the reputation well-known manifest (default: ACK treasury)
# TOOL_CREATOR_ADDRESS=0x668aDd9213985E7Fd613Aec87767C892f4b9dF1c
# TOOL_PAYOUT_ADDRESS=
# Reputation: npx tsx scripts/register-tool.ts
# Kudos:      npx tsx scripts/register-kudos-tool.ts
# Assembly:   npx tsx scripts/register-assembly-tool.ts

# Optional AI Assembly member roster indexer (ERC-8257 assembly tool)
# ASSEMBLY_INDEXER_URL=https://www.theaiassembly.org/api/indexer/members

# Optional X/Twitter relay chain config. Unset defaults to Base (8453).
# ACK_CHAIN can be "abstract" or "base"; ACK_CHAIN_ID can be 2741 or 8453.
# ACK_CHAIN=base
ABSTRACT_RPC_URL=https://api.mainnet.abs.xyz
BASE_RPC_URL=https://mainnet.base.org
ABSTRACT_HANDLE_REGISTRY_ADDRESS=0xf32ed012f0978a9b963df11743e797a108c94871
BASE_HANDLE_REGISTRY_ADDRESS=
ABSTRACT_PROXY_AGENT_ID=606
BASE_PROXY_AGENT_ID=

# Optional Sentinel preflight for x402 tip payments in UI
NEXT_PUBLIC_USE_SENTINEL_ROUTING=false
